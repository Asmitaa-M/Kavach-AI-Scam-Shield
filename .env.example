# Copy to backend/.env. Leave keys empty to run in offline/demo mode - tools then report "unavailable".
DATABASE_URL=sqlite:///./kavach.db            # or postgresql+psycopg://user:pass@localhost:5432/kavach
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
